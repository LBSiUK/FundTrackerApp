# Copy to .env and fill in. .env is gitignored and must never be committed.

# Signs the dashboard's login cookies. Required: without it nobody can sign in.
# Generate one with: openssl rand -hex 32
# Rotating it signs every browser out.
SESSION_SECRET=

# Only used by docker-compose.yml: the public hostname Caddy requests a
# Let's Encrypt certificate for. Ports 80 and 443 must reach this machine.
FUND_DOMAIN=fundtracker.example.com

# Optional, and normally left alone:
# PORT=3100
# FUNDTRACKER_DATA_DIR=./data
